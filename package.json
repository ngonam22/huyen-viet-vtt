{
  "name": "boilerplate",
  "version": "3.0.0",
  "description": "CSS compiler for the Boilerplate system",
  "scripts": {
    "build": "npm run generate && sass src/scss/boilerplate.scss css/boilerplate.css --style=expanded --no-source-map",
    "watch": "sass src/scss/boilerplate.scss css/boilerplate.css --style=expanded --source-map --watch",
    "generate": "node src/generate-boilerplate-system.mjs",
    "createSymlinks": "node src/create-symlinks.mjs",
    "vite": "vite build"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "^13.346.0-beta.20250812191140",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.5",
    "autoprefixer": "^10.4.27",
    "glob": "^10.3.10",
    "inquirer": "^9.2.15",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.8",
    "prompt": "^1.3.0",
    "renamer": "^5.0.0",
    "replace": "^1.2.2",
    "sass": "^1.53.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1"
  }
}
