<div class="hv-chat-card">
    <div class="hv-chat-card__header">
        <div class="hv-chat-card__title">Gieo Thiên Mệnh123</div>
        <div class="hv-chat-card__actor">{{actorName}}</div>
    </div>

    <div class="hv-chat-card__body">
        <div class="hv-chat-card__faces">
            {{#each faces}}
                <span class="hv-face">{{this}}</span>
            {{/each}}
        </div>

        <div class="hv-chat-card__total">
            {{total}}
        </div>
    </div>
</div>