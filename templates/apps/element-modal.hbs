<section class="hv-element-modal__wrapper">

    <!-- Elements -->
    <div class="tw:text-xl tw:text-beige-300">Ngũ Hành</div>
    <div class="elements-grid tw:grid tw:grid-cols-5 tw:text-center" id="elementsGrid">
        <div id="kim-tablet" class="elemental-tablet tw:flex tw:flex-wrap tw:justify-center tw:items-center tw:space-between" data-element-key="kim">
            <img src="/systems/huyen-viet-vtt/assets/icons/kim-tablet-icon.webp" alt="Fire Icon" width="25" />
            <span class="tablet-text">Kim</span>
            <div class="tw:text-beige-200 tw:text-shadow tw:font-bold tw:text-3xl">
                {{signedNumber
                        system.elements.kim.value}}
            </div>
        </div>
        <div id="moc-tablet" class="elemental-tablet tw:flex tw:flex-wrap tw:justify-center tw:items-center tw:space-between" data-element-key="moc">
            <img src="/systems/huyen-viet-vtt/assets/icons/moc-tablet-icon.webp" alt="Fire Icon" width="25" />
            <span class="tablet-text">Mộc</span>
            <div class="tw:text-beige-200 tw:text-shadow tw:font-bold tw:text-3xl">
                {{signedNumber
                        system.elements.moc.value}}
            </div>
        </div>
        <div id="thuy-tablet" class="elemental-tablet tw:flex tw:flex-wrap tw:justify-center tw:items-center tw:space-between" data-element-key="thuy">
            <img src="/systems/huyen-viet-vtt/assets/icons/thuy-tablet-icon.webp" alt="Water Icon" width="25" />
            <span class="tablet-text">Thủy</span>
            <div class="tw:text-beige-200 tw:text-shadow tw:font-bold tw:text-3xl">
                {{signedNumber
                        system.elements.thuy.value}}
            </div>
        </div>
        <div id="hoa-tablet" class="elemental-tablet tw:flex tw:flex-wrap tw:justify-center tw:items-center tw:space-between">
            <img src="/systems/huyen-viet-vtt/assets/icons/hoa-tablet-icon.webp" alt="Water Icon" width="25" />
            <span class="tablet-text">Hỏa</span>
            <div class="tw:text-beige-200 tw:text-shadow tw:font-bold tw:text-3xl">
                {{signedNumber
                        system.elements.hoa.value}}
            </div>
        </div>
        <div id="tho-tablet" class="elemental-tablet tw:flex tw:flex-wrap tw:justify-center tw:items-center tw:space-between">
            <img src="/systems/huyen-viet-vtt/assets/icons/tho-tablet-icon.webp" alt="Water Icon" width="25" />
            <span class="tablet-text">Thổ</span>
            <div class="tw:text-beige-200 tw:text-shadow tw:font-bold tw:text-3xl">
                {{signedNumber
                        system.elements.tho.value}}
            </div>
        </div>
    </div>

    <!-- Slider -->
    <div class="slider-wrap">
        <div class="slider-header">
            <div class="section-label" style="margin:0">Sức Mạnh</div>
            <div style="display:flex;align-items:baseline;gap:2px">
                <span class="slider-value" id="sliderVal">5</span>
                <span class="slider-max"> / 12</span>
            </div>
        </div>
        <input type="range" id="mainSlider" min="1" max="12" value="5"/>
        <div class="tick-row" id="tickRow"></div>
    </div>

    <!-- Advantage -->
    <div class="section-label">Ưu Thế</div>
    <div class="tw:grid tw:grid-cols-3 tw:gap-4 tw:mb-4 tw:text-center">
        <button class="roll-option-btn tw:text-base" onclick="selectOption('adv')">
            <span class="disadvantageThumb"></span>
            <span class="opt-radio"><span class="opt-dot"></span></span>Bất Lợi
        </button>
        <button class="roll-option-btn tw:text-base" onclick="selectOption('norm')">
            <span class="normalThumb"></span>
            <span class="opt-radio"><span class="opt-dot"></span></span>Thường
        </button>
        <button class="roll-option-btn tw:text-base" onclick="selectOption('dis')">
            <span class="advantageThumb"></span>
            <span class="opt-radio"><span class="opt-dot"></span></span>Ưu Thế
        </button>
    </div>

    <!-- Roll Mode -->
    <div class="section-label">Phạm Vi</div>
    <div class="tw:grid tw:grid-cols-4 tw:gap-2 tw:mb-6">
        <button class="roll-mode-btn" data-roll-mode="publicroll">
            <i class="fa-solid fa-users"></i>
            <span>Công Khai</span>
        </button>
        <button class="roll-mode-btn" data-roll-mode="gmroll">
            <i class="fa-solid fa-user-secret"></i>
            <span>Chỉ GM</span>
        </button>
        <button class="roll-mode-btn" data-roll-mode="blindroll">
            <i class="fa-solid fa-eye-slash"></i>
            <span>Ẩn Mù</span>
        </button>
        <button class="roll-mode-btn" data-roll-mode="selfroll">
            <i class="fa-solid fa-user"></i>
            <span>Riêng Tư</span>
        </button>
    </div>

    <!-- Initiative -->
    <div class="tw:mb-12">
        <div class="section-label">Roll for Initiative</div>
        <div class="initiative-list" id="initiativeList"></div>
    </div>

    <!-- CTA -->
    <button class="tw:text-beige-700 tw:bg-danger  tw:mx-auto" id="ctaBtn" data-action="roll-dice">
        <span class="cta-orn">☰</span>Gieo Thiên Mệnh<span class="cta-orn">☷</span>
    </button>
</section>
