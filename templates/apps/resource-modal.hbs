<div class="hv-resource-modal" data-type="{{type}}">

    {{! Tabs: switch between HP and MP }}
    <div class="hv-resource-modal__tabs">
        <button type="button"
                class="hv-resource-modal__tab{{#if isSucLuc}} is-active{{/if}}"
                data-action="switch-resource"
                data-tab="sucLuc">
            <span class="hv-resource-modal__tab-name">Sức Lực</span>
        </button>
        <button type="button"
                class="hv-resource-modal__tab{{#if isTamLuc}} is-active{{/if}}"
                data-action="switch-resource"
                data-tab="tamLuc">
            <span class="hv-resource-modal__tab-name">Tâm Lực</span>
        </button>
    </div>

    {{! Row 1: current / max display }}
    <div class="hv-resource-modal__display">
        <span class="hv-resource-modal__current">{{current}}</span>
        <span class="hv-resource-modal__sep">/</span>
        <span class="hv-resource-modal__base">{{base}}</span>
    </div>

    {{! Row 2: controls (left col) + vertical drum slider (right col) }}
    <div class="hv-resource-modal__body">

        <div class="hv-resource-modal__controls">
            <button type="button" class="hv-resource-modal__btn hv-resource-modal__btn--heal" data-action="heal">
                Hồi Phục
            </button>

            <input
                type="number"
                class="hv-resource-amount"
                value="{{amount}}"
                min="1"
                max="{{base}}"
            />

            <button type="button" class="hv-resource-modal__btn hv-resource-modal__btn--damage" data-action="damage">
                Chịu Đòn
            </button>
        </div>

        <div class="hv-resource-modal__slider-wrap">
            <div class="hv-resource-slider"
                 data-min="1"
                 data-max="50"
                 data-value="{{amount}}"
                 role="slider"
                 aria-valuenow="{{amount}}"
                 aria-valuemin="1"
                 aria-valuemax="50"
                 tabindex="0"
                 title="Scroll để thay đổi">

                <button type="button" class="hv-resource-slider__arrow hv-resource-slider__arrow--up" aria-label="Tăng">&#9650;</button>

                <div class="hv-resource-slider__viewport">
                    <div class="hv-resource-slider__drum">
                        <div class="hv-resource-slider__item" data-offset="-2"></div>
                        <div class="hv-resource-slider__item" data-offset="-1"></div>
                        <div class="hv-resource-slider__item" data-offset="0"></div>
                        <div class="hv-resource-slider__item" data-offset="1"></div>
                        <div class="hv-resource-slider__item" data-offset="2"></div>
                    </div>
                    <div class="hv-resource-slider__center-line"></div>
                </div>

                <button type="button" class="hv-resource-slider__arrow hv-resource-slider__arrow--down" aria-label="Giảm">&#9660;</button>

            </div>
        </div>

    </div>
</div>
