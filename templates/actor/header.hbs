{{! Sheet Header }}
<header class='sheet-header'>

    <div class='header-fields'>
        <div class='resources grid-span-2 self-start'>

            <div class="grid grid-2col">
                <div class="resource tw:text-center">
                    <img class='profile-img tw:mx-auto'
                         src='{{actor.img}}' data-edit='img' data-action='onEditImage'
                         data-tooltip='{{actor.name}}' height='160' width='160' />

                    <div class="grid col-span-2">
                        <div>
                            Túi tiền:
                        </div>
                        <span class="tw:flex tw:items-center tw:justify-right tw:gap-2">
                                {{system.currency.tien}} <img width="15px" alt="Tien currency" src="/systems/huyen-viet-vtt/assets/icons/tien.webp" />
                            {{system.currency.quan}} <img width="35px" alt="Quan currency" src="/systems/huyen-viet-vtt/assets/icons/quan.webp" />
                            </span>
                    </div>
                </div>


                <div class='resource'>
                    <div class="resource">
                        <label for='name' class='resource-label'>
                            Tên
                        </label>
                        <div class='resource-content flexrow flex-center flex-between'>
                            <input name='name' type='text' value='{{actor.name}}' placeholder='Name' />
                        </div>
                    </div>

                    <div class='resource'>
                        <label for='hv-thi-toc-select' class='resource-label'>
                            Thị Tộc
                        </label>
                        <div class='resource-content flexrow flex-center flex-between'>
                            <select
                                    id="hv-thi-toc-select"
                                    name="demo"
                                    class="hv-thi-toc-select"
                                    {{#unless editable}}disabled{{/unless}}
                            >
                                <option value="" disabled {{#unless document.system.identity.thiToc}}selected{{/unless}}>
                                    -- Chọn Thị Tộc --
                                </option>

                                {{#each thiTocOptions as |option|}}
                                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                                        {{localize option.label }}
                                    </option>
                                {{/each}}
                            </select>
                        </div>
                    </div>

                    <div class='resource'>
                        <label for='hv-boi-canh-select' class='resource-label'>
                            Bối Cảnh
                        </label>
                        <div class='resource-content flexrow flex-center flex-between'>
                            <select
                                    id="hv-boi-canh-select"
                                    name="boi-canh"
                                    class="hv-boi-canh-select"
                                    {{#unless editable}}disabled{{/unless}}
                            >
                                <option value="" disabled {{#unless document.system.identity.boiCanh}}selected{{/unless}}>
                                    -- Chọn Bối Cảnh --
                                </option>

                                {{#each boiCanhOptions as |option|}}
                                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                                        {{localize option.label }}
                                    </option>
                                {{/each}}
                            </select>
                        </div>
                    </div>

                    <div class='resource'>
                        <label for='hv-gia-canh-select' class='resource-label'>
                            Gia Cảnh
                        </label>
                        <div class='resource-content flexrow flex-center flex-between'>
                            <select
                                    id="hv-gia-canh-select"
                                    name="gia-canh"
                                    class="hv-gia-canh-select"
                                    {{#unless editable}}disabled{{/unless}}
                            >
                                <option value="" disabled {{#unless document.system.identity.giaCanh}}selected{{/unless}}>
                                    -- Chọn Gia Cảnh --
                                </option>

                                {{#each giaCanhOptions as |option|}}
                                    <option value="{{option.id}}" {{#if option.selected}}selected{{/if}}>
                                        {{localize option.ten }}
                                    </option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>


            <div class="tw:grid tw:grid-cols-6 tw:grid-rows-2 tw:gap-4 tw:items-center tw:content-center">
                <div class="tw:row-span-3 tw:col-span-3">
                    <div id="ngu-hanh-canvas" style="position: relative;">
                        <!--                    <video id="video-kim" class="energy-video" autoplay loop muted playsinline>-->
                        <!--                        <source src="systems/huyen-viet-vtt/assets/kim-energy.webm" type="video/webm">-->
                        <!--                        Your browser does not support the video tag.-->
                        <!--                    </video>-->

                        <!--                    <video id="video-thuy" class="energy-video" autoplay loop muted playsinline>-->
                        <!--                        <source src="systems/huyen-viet-vtt/assets/thuy-energy.webm" type="video/webm">-->
                        <!--                        Your browser does not support the video tag.-->
                        <!--                    </video>-->

                        <!--                    <video id="video-hoa" class="energy-video" autoplay loop muted playsinline>-->
                        <!--                        <source src="systems/huyen-viet-vtt/assets/hoa-energy.webm" type="video/webm">-->
                        <!--                        Your browser does not support the video tag.-->
                        <!--                    </video>-->

                        <!--                    <video id="video-moc" class="energy-video" autoplay loop muted playsinline>-->
                        <!--                        <source src="systems/huyen-viet-vtt/assets/moc-energy.webm" type="video/webm">-->
                        <!--                        Your browser does not support the video tag.-->
                        <!--                    </video>-->

                        <!--                    <video id="video-tho" class="energy-video" autoplay loop muted playsinline>-->
                        <!--                        <source src="systems/huyen-viet-vtt/assets/tho-energy.webm" type="video/webm">-->
                        <!--                        Your browser does not support the video tag.-->
                        <!--                    </video>-->
                        {{#each elements as |element|}}
                            <video id="video-{{element}}"
                                   class="energy-video {{#if (eq ../hanhThe element)}}active{{/if}}"
                                   autoplay loop muted playsinline>
                                <source src="systems/huyen-viet-vtt/assets/{{element}}-energy.webm" type="video/webm">
                            </video>
                        {{/each}}

                        <div id="ngu-hanh-holder">
                            <svg id="nguHanhSVG" viewBox="0 0 460 355" xmlns="http://www.w3.org/2000/svg" fill="none">
                                <defs>
                                    <!-- Sinh arrow: gold -->
                                    <marker id="mSinh" markerWidth="9" markerHeight="9" refX="7" refY="3.5" orient="auto">
                                        <path d="M0,0 L0,7 L9,3.5 z" fill="rgba(212,168,67,0.85)" />
                                    </marker>
                                    <!-- Khắc arrow: red -->
                                    <marker id="mKhac" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                                        <path d="M0,0 L0,6 L8,3 z" fill="rgba(220,80,80,0.9)" />
                                    </marker>

                                    <radialGradient id="bgKim" cx="50%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#e8e0c8" stop-opacity=".22" />
                                        <stop offset="100%" stop-color="#d4c9a8" stop-opacity=".03" />
                                    </radialGradient>
                                    <radialGradient id="bgThuy" cx="50%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#5ba3d4" stop-opacity=".22" />
                                        <stop offset="100%" stop-color="#2e6a9e" stop-opacity=".03" />
                                    </radialGradient>
                                    <radialGradient id="bgMoc" cx="50%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#6db87a" stop-opacity=".22" />
                                        <stop offset="100%" stop-color="#3d7a48" stop-opacity=".03" />
                                    </radialGradient>
                                    <radialGradient id="bgHoa" cx="50%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#e07b4a" stop-opacity=".22" />
                                        <stop offset="100%" stop-color="#a04020" stop-opacity=".03" />
                                    </radialGradient>
                                    <radialGradient id="bgTho" cx="50%" cy="35%" r="65%">
                                        <stop offset="0%" stop-color="#c49a5a" stop-opacity=".22" />
                                        <stop offset="100%" stop-color="#8a6030" stop-opacity=".03" />
                                    </radialGradient>
                                </defs>

                                <!-- ══ LAYER 1: TƯƠNG SINH circle (bottom) ══ -->
                                <circle cx="230" cy="183" r="131" stroke="rgba(212,168,67,0.08)" stroke-width="6"
                                        fill="none" />
                                <path id="circle-sinh" d="M 241,53 A 131,131 0 1 1 219,53" stroke="rgba(212,168,67,0.62)"
                                      stroke-width="1.8" fill="none" marker-end="url(#mSinh)" />

                                <!-- ══ LAYER 2: TƯƠNG KHẮC diagonals ══ -->
                                <line id="khac-kim-moc" x1="243" y1="93" x2="294" y2="253" stroke="rgba(220,80,80,.6)"
                                      stroke-width="1.3" stroke-dasharray="4 3.5" marker-end="url(#mKhac)" />
                                <line id="khac-moc-tho" x1="273" y1="268" x2="142" y2="167" stroke="rgba(220,80,80,.6)"
                                      stroke-width="1.3" stroke-dasharray="4 3.5" marker-end="url(#mKhac)" />
                                <line id="khac-tho-thuy" x1="151" y1="141" x2="309" y2="141" stroke="rgba(220,80,80,.6)"
                                      stroke-width="1.3" stroke-dasharray="4 3.5" marker-end="url(#mKhac)" />
                                <line id="khac-thuy-hoa" x1="318" y1="167" x2="187" y2="268" stroke="rgba(220,80,80,.6)"
                                      stroke-width="1.3" stroke-dasharray="4 3.5" marker-end="url(#mKhac)" />
                                <line id="khac-hoa-kim" x1="166" y1="253" x2="217" y2="93" stroke="rgba(220,80,80,.6)"
                                      stroke-width="1.3" stroke-dasharray="4 3.5" marker-end="url(#mKhac)" />

                                <!-- ══ LAYER 3: NODES (on top) ══ -->


                                <!-- KIM -->
                                <g class="hanh-node" id="node-kim" data-action="toggle-hanh-the" data-element="kim"
                                   role="button" aria-label="Kim">
                                    <circle cx="230" cy="52" r="40" fill="#162030" />
                                    <circle cx="230" cy="52" r="40" fill="url(#bgKim)" stroke="#d4c9a8" stroke-width="1.5"
                                            stroke-opacity=".7" />
                                    <circle cx="230" cy="52" r="40" fill="none" stroke="#d4c9a8" stroke-width=".5"
                                            stroke-opacity=".2" stroke-dasharray="3 6" />
                                    <text x="230" y="38" text-anchor="middle" font-size="15" fill="#d4c9a8">⚙</text>
                                    <text x="230" y="55" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="13" font-weight="600" fill="#e8e0c8" letter-spacing=".5">Kim</text>
                                    <text x="230" y="69" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="12" font-weight="700" fill="#d4c9a8">{{signedNumber
                                            system.elements.kim.value}}</text>
                                </g>

                                <!-- THỦY -->
                                <g class="hanh-node" id="node-thuy" data-action="toggle-hanh-the" data-element="thuy"
                                   role="button" aria-label="Thủy">
                                    <circle cx="352" cy="141" r="40" fill="#162030" />
                                    <circle cx="352" cy="141" r="40" fill="url(#bgThuy)" stroke="#5ba3d4" stroke-width="1.5"
                                            stroke-opacity=".7" />
                                    <circle cx="352" cy="141" r="40" fill="none" stroke="#5ba3d4" stroke-width=".5"
                                            stroke-opacity=".2" stroke-dasharray="3 6" />
                                    <text x="352" y="127" text-anchor="middle" font-size="15" fill="#5ba3d4">💧</text>
                                    <text x="352" y="145" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="13" font-weight="600" fill="#a8d4f0" letter-spacing=".5">Thủy</text>
                                    <text x="352" y="159" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="12" font-weight="700" fill="#5ba3d4">{{signedNumber
                                            system.elements.thuy.value}}</text>
                                </g>

                                <!-- MỘC -->
                                <g class="hanh-node" id="node-moc" data-action="toggle-hanh-the" data-element="moc"
                                   role="button" aria-label="Mộc">
                                    <circle cx="307" cy="294" r="40" fill="#162030" />
                                    <circle cx="307" cy="294" r="40" fill="url(#bgMoc)" stroke="#6db87a" stroke-width="1.5"
                                            stroke-opacity=".7" />
                                    <circle cx="307" cy="294" r="40" fill="none" stroke="#6db87a" stroke-width=".5"
                                            stroke-opacity=".2" stroke-dasharray="3 6" />
                                    <text x="307" y="280" text-anchor="middle" font-size="15" fill="#6db87a">🌿</text>
                                    <text x="307" y="298" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="13" font-weight="600" fill="#a8d4b0" letter-spacing=".5">Mộc</text>
                                    <text x="307" y="312" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="12" font-weight="700" fill="#6db87a">{{signedNumber
                                            system.elements.moc.value}}</text>
                                </g>

                                <!-- HỎA -->
                                <g class="hanh-node" id="node-hoa" data-action="toggle-hanh-the" data-element="hoa"
                                   role="button" aria-label="Hỏa">
                                    <circle cx="153" cy="294" r="40" fill="#162030" />
                                    <circle cx="153" cy="294" r="40" fill="url(#bgHoa)" stroke="#e07b4a" stroke-width="1.5"
                                            stroke-opacity=".7" />
                                    <circle cx="153" cy="294" r="40" fill="none" stroke="#e07b4a" stroke-width=".5"
                                            stroke-opacity=".2" stroke-dasharray="3 6" />
                                    <text x="153" y="280" text-anchor="middle" font-size="15" fill="#e07b4a">🔥</text>
                                    <text x="153" y="298" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="13" font-weight="600" fill="#f0b890" letter-spacing=".5">Hỏa</text>
                                    <text x="153" y="312" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="12" font-weight="700" fill="#e07b4a">{{signedNumber
                                            system.elements.hoa.value}}</text>
                                </g>

                                <!-- THỔ -->
                                <g class="hanh-node" id="node-tho" data-action="toggle-hanh-the" data-element="tho"
                                   role="button" aria-label="Thổ">
                                    <circle cx="108" cy="141" r="40" fill="#162030" />
                                    <circle cx="108" cy="141" r="40" fill="url(#bgTho)" stroke="#c49a5a" stroke-width="1.5"
                                            stroke-opacity=".7" />
                                    <circle cx="108" cy="141" r="40" fill="none" stroke="#c49a5a" stroke-width=".5"
                                            stroke-opacity=".2" stroke-dasharray="3 6" />
                                    <text x="108" y="127" text-anchor="middle" font-size="15" fill="#c49a5a">⛰</text>
                                    <text x="108" y="145" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="13" font-weight="600" fill="#e0c890" letter-spacing=".5">Thổ</text>
                                    <text x="108" y="159" text-anchor="middle" font-family="'Crimson Pro',serif"
                                          font-size="12" font-weight="700" fill="#c49a5a">{{signedNumber
                                            system.elements.tho.value}}</text>
                                </g>

                            </svg>
                        </div>
                    </div>
                </div>

                <!-- starts ability box -->
                <div class='tw:col-start-4 resource flex-group-center ability-box ability-box--resource'
                     data-action="open-resource-modal" data-type="sucLuc" role="button">
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.sucLuc.label'}}
                    </div>
                    <div class='ability-box__content ability-box__content--resource'>
                        <span class="ability-box__current">{{system.abilities.sucLuc.value}}</span>
                        <span class="ability-box__sep">/</span>
                        <span class="ability-box__base">{{system.abilities.sucLuc.base}}</span>
                    </div>
                </div>

                <div class='tw:col-start-5 ability-box ability-box--resource'
                     data-action="open-resource-modal" data-type="tamLuc" role="button">
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.tamLuc.label'}}
                    </div>
                    <div class='ability-box__content ability-box__content--resource'>
                        <span class="ability-box__current">{{system.abilities.tamLuc.value}}</span>
                        <span class="ability-box__sep">/</span>
                        <span class="ability-box__base">{{system.abilities.tamLuc.base}}</span>
                    </div>
                </div>

                <div class='tw:col-start-6 ability-box'>
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.canhGiac.label'}}
                    </div>
                    <div class='ability-box__content'>
                        {{system.abilities.canhGiac.value}}
                    </div>
                </div>

                <div class='tw:col-start-4 tw:row-start-2 ability-box'>
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.chuTam.label'}}
                    </div>
                    <div class='ability-box__content'>
                        {{system.abilities.chuTam.value}}
                    </div>
                </div>

                <div class='ability-box tw:col-start-5 tw:row-start-2'>
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.tocDo.label'}}
                    </div>
                    <div class='ability-box__content'>
                        {{system.abilities.tocDo.value}}
                    </div>
                </div>

                <div class='ability-box tw:col-start-6 tw:row-start-2'>
                    <div class='ability-box__title'>
                        {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.nguHop.label'}}
                    </div>
                    <div class='ability-box__content'>
                        {{system.abilities.nguHop.value}}
                    </div>
                </div>
            </div>

        </div>

        <div class="tw:grid tw:grid-cols-5 tw:gap-3 tw:mt-4">
            <div class="ability-block">
                <div class="ability-block__header">
                    <div class="ability-block__ornament"></div>
                    <span class="ability-block__section-title">Học Đạo</span>
                    <span class="ability-block__section-icon">⚖</span>
                </div>

                <ul class="ability-block__list">
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="chinhTri">
                        <span class="ability-block__ability-name">Chính Trị</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.chinhTri}}">
                            {{signedNumber system.skills.chinhTri}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="khoaHoc">
                        <span class="ability-block__ability-name">Khoa Học</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.khoaHoc}}">
                            {{signedNumber system.skills.khoaHoc}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="thanHoc">
                        <span class="ability-block__ability-name">Thần Học</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.thanHoc}}">
                            {{signedNumber system.skills.thanHoc}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="xaHoi">
                        <span class="ability-block__ability-name">Xã Hội</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.xaHoi}}">
                            {{signedNumber system.skills.xaHoi}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="yHoc">
                        <span class="ability-block__ability-name">Y Học</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.yHoc}}">
                            {{signedNumber system.skills.yHoc}}
                        </span>
                    </li>
                </ul>
            </div>

            <section class="ability-block">
                <div class="ability-block__header">
                    <div class="ability-block__ornament"></div>
                    <span class="ability-block__section-title">Nghệ Đạo</span>
                    <span class="ability-block__section-icon">⚖</span>
                </div>

                <ul class="ability-block__list">
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="myThuat">
                        <span class="ability-block__ability-name">Mỹ Thuật</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.myThuat}}">
                            {{signedNumber system.skills.myThuat}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="vanTu">
                        <span class="ability-block__ability-name">Văn Tự</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.vanTu}}">
                            {{signedNumber system.skills.vanTu}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="thoiTrang">
                        <span class="ability-block__ability-name">Thời Trang</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.thoiTrang}}">
                            {{signedNumber system.skills.thoiTrang}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="chienCu">
                        <span class="ability-block__ability-name">Chiến cụ</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.chienCu}}">
                            {{signedNumber system.skills.chienCu}}
                        </span>
                    </li>
                </ul>

            </section>

            <div class="ability-block">
                <div class="ability-block__header">
                    <div class="ability-block__ornament"></div>
                    <span class="ability-block__section-title">Sinh Đạo</span>
                    <span class="ability-block__section-icon">⚖</span>
                </div>

                <ul class="ability-block__list">
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="laoDong">
                        <span class="ability-block__ability-name">Lao Động</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.laoDong}}">
                            {{signedNumber system.skills.laoDong}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="thuongNghiep">
                        <span class="ability-block__ability-name">Thương Nghiệp</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.thuongNghiep}}">
                            {{signedNumber system.skills.thuongNghiep}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="haiNghiep">
                        <span class="ability-block__ability-name">Hải Nghiệp</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.haiNghiep}}">
                            {{signedNumber system.skills.haiNghiep}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="hacNghiep">
                        <span class="ability-block__ability-name">Hắc Nghiệp</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.hacNghiep}}">
                            {{signedNumber system.skills.hacNghiep}}
                        </span>
                    </li>

                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="sinhTon">
                        <span class="ability-block__ability-name">Sinh Tồn</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.sinhTon}}">
                            {{signedNumber system.skills.sinhTon}}
                        </span>
                    </li>
                </ul>
            </div>

            <div class="ability-block">
                <div class="ability-block__header">
                    <div class="ability-block__ornament"></div>
                    <span class="ability-block__section-title">Tâm Đạo</span>
                    <span class="ability-block__section-icon">⚖</span>
                </div>

                <ul class="ability-block__list" data-action="roll-skill" data-target="lanhDao">
                    <li class="ability-block__ability-item">
                        <span class="ability-block__ability-name">Lãnh Đạo</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.lanhDao}}">
                            {{signedNumber system.skills.lanhDao}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="leDao">
                        <span class="ability-block__ability-name">Lễ Đạo</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.leDao}}">
                            {{signedNumber system.skills.leDao}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="bieuDien">
                        <span class="ability-block__ability-name">Biểu Diễn</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.bieuDien}}">
                            {{signedNumber system.skills.bieuDien}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="tamY">
                        <span class="ability-block__ability-name">Tâm Ý</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.tamY}}">
                            {{signedNumber system.skills.tamY}}
                        </span>
                    </li>
                </ul>
            </div>

            <div class="ability-block" data-action="roll-skill">

                <div class="ability-block__header">
                    <div class="ability-block__ornament"></div>
                    <span class="ability-block__section-title">Võ Đạo</span>
                    <span class="ability-block__section-icon">⚖</span>
                </div>

                <ul class="ability-block__list">
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="theThuat">
                        <span class="ability-block__ability-name">Thể Thuật</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.theThuat}}">
                            {{signedNumber system.skills.theThuat}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="voThuat">
                        <span class="ability-block__ability-name">Võ Thuật</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.voThuat}}">
                            {{signedNumber system.skills.voThuat}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="binhPhap">
                        <span class="ability-block__ability-name">Binh Pháp</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.binhPhap}}">
                            {{signedNumber system.skills.binhPhap}}
                        </span>
                    </li>
                    <li class="ability-block__ability-item" data-action="roll-skill" data-target="thienDinh">
                        <span class="ability-block__ability-name">Thiền Định</span>
                        <span
                                class="ability-block__ability-score ability-block__score-{{scoreClass system.skills.thienDinh}}">
                            {{signedNumber system.skills.thienDinh}}
                        </span>
                    </li>
                </ul>
            </div>
        </div>



        <button type="button" data-action="roll-skill" data-skill="voThuat" data-element="hoa" data-dc="2"
            data-label="Võ Thuật + Hỏa">
            Roll
        </button>

        <button type="button" data-action="test-dsn" data-skill="voThuat" data-element="hoa" data-dc="2"
                data-label="Võ Thuật + Hỏa">
            Test DSN !!!!!
        </button>

        <div class='resources grid grid-3col'>

            <div class='resource flex-group-center'>
                {{#if (eq actor.type 'character')}}
                <label class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.Character.FIELDS.attributes.level.value.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='number' name='system.attributes.level.value' value='{{system.attributes.level.value}}'
                        step='1' />
                </div>
                {{/if}}
                {{#if (eq actor.type 'npc')}}
                <label class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.NPC.FIELDS.cr.label'}} / {{localize
                    'BOILERPLATE.Actor.NPC.xp.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='number' name='system.cr' value='{{system.cr}}' step='1' />
                    <span></span>
                    <input type='number' disabled='true' name='system.xp' value='{{system.xp}}' step='1' />
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</header>