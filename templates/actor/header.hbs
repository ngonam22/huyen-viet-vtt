{{! Sheet Header }}
<header class='sheet-header'>

    <div class='header-fields'>


        <div class='resources grid grid-2col'>
            <img class='profile-img' src='{{actor.img}}' data-edit='img' data-action='onEditImage'
                data-tooltip='{{actor.name}}' height='100' width='100' />

            <div class='resource'>
                <div class="resource">
                    <label for='name' class='resource-label'>
                        Tên
                    </label>
                    <div class='resource-content flexrow flex-center flex-between'>
                        <input name='name' type='text' value='{{actor.name}}' placeholder='Name' />
                    </div>
                </div>

                <div class='resource'>
                    <label for='system.health.value' class='resource-label'>
                        Thị Tộc
                    </label>
                    <div class='resource-content flexrow flex-center flex-between'>
                        <input name='system.thiToc' type='text' value='{{system.thiToc}}' placeholder='Thị Tộc' />
                    </div>
                </div>
            </div>
        </div>
        {{! The grid classes are defined in scss/global/_grid.scss. To use,
        use both the "grid" and "grid-Ncol" class where "N" can be any number
        from 1 to 12 and will create that number of columns. }}
        <div class='resources grid grid-3col'>
            <div class='resource flex-group-center'>
                <label for='system.health.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.sucLuc.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.sucLuc.value' value='{{system.abilities.sucLuc.value}}'
                        data-dtype='Number' />
                </div>
            </div>

            <div class='resource flex-group-center'>
                <label for='system.health.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.tamLuc.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.tamLuc.value' value='{{system.abilities.tamLuc.value}}'
                        data-dtype='Number' />
                </div>
            </div>

            <div class='resource flex-group-center'>
                <label for='system.health.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.canhGiac.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.canhGiac.value'
                        value='{{system.abilities.canhGiac.value}}' data-dtype='Number' />
                </div>
            </div>
        </div>

        <div class='resources grid grid-3col'>
            <div class='resource flex-group-center'>
                <label for='system.health.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.chuTam.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.chuTam.value' value='{{system.abilities.chuTam.value}}'
                        data-dtype='Number' />
                </div>
            </div>

            <div class='resource flex-group-center'>
                <label for='system.abilities.tocDo.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.tocDo.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.tocDo.value' value='{{system.abilities.tocDo.value}}'
                        data-dtype='Number' />
                </div>
            </div>

            <div class='resource flex-group-center'>
                <label for='system.nguHanh.nguHop.value' class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.base.FIELDS.nguHanh.nguHop.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.abilities.nguHop.value' value='{{system.abilities.nguHop.value}}'
                        data-dtype='Number' />
                </div>
            </div>
        </div>


        <div class='resources grid grid-3col'>

            <div class='resource flex-group-center'>
                {{#if (eq actor.type 'character')}}
                <label class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.Character.FIELDS.attributes.level.value.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.attributes.level.value' value='{{system.attributes.level.value}}'
                        data-dtype='Number' />
                </div>
                {{/if}}
                {{#if (eq actor.type 'npc')}}
                <label class='resource-label'>
                    {{localize 'BOILERPLATE.Actor.NPC.FIELDS.cr.label'}} / {{localize
                    'BOILERPLATE.Actor.NPC.xp.label'}}
                </label>
                <div class='resource-content flexrow flex-center flex-between'>
                    <input type='text' name='system.cr' value='{{system.cr}}' data-dtype='Number' />
                    <span></span>
                    <input type='text' disabled='true' name='system.xp' value='{{system.xp}}' data-dtype='Number' />
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</header>