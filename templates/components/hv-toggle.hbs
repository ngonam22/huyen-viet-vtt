{{!--
  ┌──────────────────────────────────────────────────────────────────────────┐
  │  hv-toggle — Segmented binary toggle (sliding pill)                      │
  ├──────────────────────────────────────────────────────────────────────────┤
  │  Parameters (pass as hash args to the partial):                          │
  │    action      {string}   data-action fired when an option is clicked    │
  │    optA        {string}   value identifier for option A                  │
  │    labelA      {string}   display label for option A                     │
  │    optB        {string}   value identifier for option B                  │
  │    labelB      {string}   display label for option B                     │
  │    activeValue {string}   currently active option value                  │
  │    minimal     {boolean}  if true, renders dot-only pill (no labels)     │
  │                                                                          │
  │  CSS modifiers on the container:                                         │
  │    .hv-toggle--labeled    sliding teal pill with labels (default)        │
  │    .hv-toggle--minimal    dot-only pill, no labels                       │
  │  Pill position is set by JS via --pill-left / --pill-width CSS vars.     │
  │                                                                          │
  │  Usage (labeled, default):                                               │
  │    {{> hv-toggle                                                         │
  │        action="toggle-inventory-view"                                    │
  │        optA="equipped" labelA="Đang Trang Bị"                           │
  │        optB="all"      labelB="Tất Cả"                                  │
  │        activeValue=inventoryView                                         │
  │    }}                                                                    │
  │                                                                          │
  │  Usage (minimal, no labels):                                             │
  │    {{> hv-toggle action="..." optA="..." optB="..."                      │
  │        activeValue=someValue minimal=true}}                               │
  │                                                                          │
  │  See scss/components/_ui-components.scss for visual states.              │
  │  See specs/ui-patterns.md for UX rationale.                              │
  └──────────────────────────────────────────────────────────────────────────┘
--}}
<div class="hv-toggle {{#if minimal}}hv-toggle--minimal{{else}}hv-toggle--labeled{{/if}}" role="group">
  {{#unless minimal}}<span class="hv-toggle__pill" aria-hidden="true"></span>{{/unless}}
  <button type="button"
          class="hv-toggle__opt {{#if (eq activeValue optA)}}is-active{{/if}}"
          data-action="{{action}}"
          data-value="{{optA}}">
    {{#unless minimal}}{{labelA}}{{/unless}}
  </button>
  <button type="button"
          class="hv-toggle__opt {{#if (eq activeValue optB)}}is-active{{/if}}"
          data-action="{{action}}"
          data-value="{{optB}}">
    {{#unless minimal}}{{labelB}}{{/unless}}
  </button>
</div>
