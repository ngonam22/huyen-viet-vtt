{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node",
      "@league-of-foundry-developers/foundry-vtt-types"
    ]
  },
  "include": [
    "module/**/*.ts",
    "module/**/*.mts",
    "module/**/*.js",
    "module/**/*.mjs",
    "types/**/*.d.ts",
    "vite.config.ts",
    "scripts/**/*.mjs"
  ]
}